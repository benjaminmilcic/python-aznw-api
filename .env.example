# Copy to .env and fill in. .env is in .gitignore – never commit real values.

# Chat model via LiteLLM (OpenAI)
OPENAI_API_KEY=sk-...
LLM_MODEL=openai/gpt-5.4-mini
REASONING_EFFORT=low
# Upper limit per model call (answer plus reasoning)
MAX_COMPLETION_TOKENS=4000
# Costs of all visitors together per day (UTC) in US dollars – above it the chat pauses until midnight UTC. 0 = off
DAILY_BUDGET_USD=2

# Speech input via LiteLLM (Groq Whisper)
GROQ_API_KEY=gsk_...
TRANSCRIPTION_MODEL_FAST=groq/whisper-large-v3-turbo
TRANSCRIPTION_MODEL_QUALITY=groq/whisper-large-v3
# Token budget of the conversation history – above it, older messages are summarized (once, then again only when
# the history has grown beyond it again)
HISTORY_TOKEN_BUDGET=4000

# NestJS backend (nest-aznw-api). Locally this is the production API as well, so the tools always work with the
# real data (recipes, guestbook, jokes, high scores). On the server: http://127.0.0.1:3000 (set in the systemd unit).
NEST_API_URL=https://api.benjamin-milcic.dev

# Shared secret with nest-aznw-api (same value as INTERNAL_API_KEY there). Sent to NestJS for internal endpoints
# (jokes) and required by this API for /chat/stream and /transcribe. For the jokes tool locally, this must be the
# production value, because the jokes come from the production API.
INTERNAL_API_KEY=

# Knowledge base (RAG): a local checkout of aznw-routes, or github:benjaminmilcic/aznw-routes@new
KNOWLEDGE_SOURCE=../aznw-routes
KNOWLEDGE_REFRESH_MINUTES=15

# Embeddings: Cloudflare worker of benjamin-milcic.dev (same WORKER_SECRET as in nest-aznw-api and the worker)
EMBED_URL=https://little-sky-725e.benjamin-milcic.workers.dev/embed
WORKER_SECRET=
